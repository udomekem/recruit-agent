# Copy to .env and fill in. Never commit .env.
# Every setting the app reads is listed here (a test checks this).

ENVIRONMENT=development

# Storage and queue (defaults match docker compose)
DATABASE_URL=postgresql+psycopg://recruit:recruit@localhost:5432/recruit
REDIS_URL=redis://localhost:6379/0

# Recruiter identity (phase 0: one bearer token)
RECRUITER_TOKEN=
RECRUITER_ID=recruiter-dev  # gitleaks:allow (an id label, not a secret)

# Language model provider: kie (default, kie.ai DeepSeek) or anthropic
LLM_PROVIDER=kie
KIE_API_KEY=
KIE_RESPONSES_URL=https://api.kie.ai/openai/v1/responses
ANTHROPIC_API_KEY=
# For LLM_PROVIDER=anthropic use claude-haiku-5-5 and claude-sonnet-5-5
MODEL_EXTRACTION=deepseek-v4-1-flash
MODEL_JUDGEMENT=deepseek-v4-1-flash
EFFORT_EXTRACTION=low
EFFORT_JUDGEMENT=high
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=16000
LLM_MAX_INVALID_RETRIES=2
LLM_MAX_PROVIDER_RETRIES=3
LLM_MAX_CALLS_PER_PROCESS=50

# Langfuse (tracing is off when either key is empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Workflow
STEP_MAX_ATTEMPTS=3
STEP_TIMEOUT_SECONDS=30
STEP_RETRY_BACKOFF_SECONDS=1.0
SCREEN_CALL_MAX_ATTEMPTS=3
NO_ANSWER_RETRY_DELAY_SECONDS=3600

# Side effect switches (keep false until the phase that needs them)
EMAIL_SENDING_ENABLED=false
PHONE_CALLS_ENABLED=false
CALENDAR_BOOKING_ENABLED=false

# Intake and CV storage (phase 1). S3 compatible; MinIO in docker compose locally.
COMPANY_NAME=Northwind Talent (demo)
CV_MAX_BYTES=5242880
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=recruit-cvs
S3_REGION=ap-southeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=

# MinIO server settings, read by docker compose only (not by the app).
# Generate the KMS key with: echo "recruit-key:$(head -c 32 /dev/urandom | base64)"
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_KMS_SECRET_KEY=
